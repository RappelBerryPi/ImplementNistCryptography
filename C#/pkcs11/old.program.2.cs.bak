using System.Security.Cryptography.X509Certificates;
using Net.Pkcs11Interop.Common;
using Net.Pkcs11Interop.HighLevelAPI;

public class Program {
    public static void Main(string[] args) {
        const string library = "C:\\Program Files\\Yubico\\Yubico PIV Tool\\bin\\libykcs11.dll";
        Pkcs11InteropFactories factories = new Pkcs11InteropFactories();
        using (IPkcs11Library pkcs11Library = factories.Pkcs11LibraryFactory.LoadPkcs11Library(factories, library, AppType.SingleThreaded)) {
            ILibraryInfo libraryInfo = pkcs11Library.GetInfo();
            ISlot slot = pkcs11Library.GetSlotList(SlotsType.WithTokenPresent).First();
            using (ISession session = slot.OpenSession(SessionType.ReadOnly)) {
                session.Login(CKU.CKU_USER, args[0]);

                List<IObjectAttribute> objectAttributes = new List<IObjectAttribute>();
                objectAttributes.Add(session.Factories.ObjectAttributeFactory.Create(CKA.CKA_CLASS, CKO.CKO_CERTIFICATE));

                List<IObjectHandle> objects = session.FindAllObjects(objectAttributes);

                List<CKA> publicCertList = new List<CKA>();
                publicCertList.Add(CKA.CKA_VALUE);
                publicCertList.Add(CKA.CKA_ID);
                foreach (IObjectHandle objectHandle in objects) {
                    List<IObjectAttribute> certificate = session.GetAttributeValue(objectHandle, publicCertList);
                     Console.WriteLine(Convert.ToBase64String(certificate[1].GetValueAsByteArray()));
                    // Console.WriteLine(Convert.ToBase64String(certificate[0].GetValueAsByteArray()));
                    Console.WriteLine();
                }
            }
        }
    }
}